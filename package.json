{
  "name": "wizard",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone demo of the Bible Game landing page with a playable practice round, for mapping out the new-player flow",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5180",
    "check:emblems": "esbuild scripts/check-emblems.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --log-level=warning | node --input-type=module"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.7.0",
    "@project-gridmap/library": "0.1.12",
    "framer-motion": "^12.5.0",
    "lucide-react": "^0.539.0",
    "react": "19.0.1",
    "react-canvas-confetti": "^1.4.0",
    "react-dom": "19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "postcss": "^8",
    "sass": "^1.78.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^6.0.0"
  }
}
