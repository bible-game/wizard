{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./src/web-shims/next-link.tsx"],
      "next/navigation": ["./src/web-shims/next-navigation.ts"],
      "swr": ["./src/web-shims/swr.ts"],
      "@heroui/react": ["./src/web-shims/heroui.tsx"],
      "@heroui/button": ["./src/web-shims/heroui.tsx"]
    }
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
